<idea-plugin>
    <id>io.github.ayfri.kore.kore-assistant</id>
    <name>Kore Assistant</name>
    <vendor email="pierre.ayfri@gmail.com" url="https://ayfri.com">Ayfri</vendor>
    <description>This text will be replaced with README content.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <!-- Run integration drives the Kore Gradle plugin's tasks; Maven users keep everything else. -->
    <depends optional="true" config-file="kore-gradle.xml">com.intellij.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="io.github.ayfri.kore.koreassistant.gutter.DataPackGutterProvider"/>
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="io.github.ayfri.kore.koreassistant.gutter.FunctionGutterProvider"/>
        <codeInsight.lineMarkerProvider
                language="kotlin"
                implementationClass="io.github.ayfri.kore.koreassistant.gutter.DeclarationGutterProvider"/>

        <!-- Registered here rather than programmatically: the manager's builder API is override-only.
             KoreToolWindowRegistrar only flips its availability once it knows whether this is a Kore project. -->
        <toolWindow
                id="Kore Elements"
                anchor="right"
                icon="/images/kore-white.svg"
                factoryClass="io.github.ayfri.kore.koreassistant.toolwindow.KoreToolWindowFactory"/>

        <postStartupActivity
                implementation="io.github.ayfri.kore.koreassistant.toolwindow.KoreToolWindowRegistrar"/>
        <postStartupActivity implementation="io.github.ayfri.kore.koreassistant.settings.KoreUpdateChecker"/>

        <applicationConfigurable
                parentId="tools"
                id="io.github.ayfri.kore.koreassistant.settings"
                displayName="Kore Assistant"
                instance="io.github.ayfri.kore.koreassistant.settings.KoreSettingsConfigurable"/>
        <notificationGroup id="Kore Assistant" displayType="BALLOON"/>

        <defaultLiveTemplates file="/liveTemplates/Kore.xml"/>
        <liveTemplateOptionalProcessor implementation="io.github.ayfri.kore.koreassistant.templates.KoreTemplateImportProcessor"/>
        <internalFileTemplate name="Kore DataPack"/>

        <errorHandler implementation="io.github.ayfri.kore.koreassistant.diagnostic.KoreErrorReportSubmitter"/>

        <fileBasedIndex implementation="io.github.ayfri.kore.koreassistant.index.KoreDeclarationIndex"/>

        <psi.referenceContributor
                language="kotlin"
                implementation="io.github.ayfri.kore.koreassistant.references.KoreFunctionReferenceContributor"/>
        <referencesSearch implementation="io.github.ayfri.kore.koreassistant.references.KoreFunctionReferencesSearcher"/>
        <!-- First, so Kotlin's factory never gets asked about a target that is not a Kotlin declaration. -->
        <findUsagesHandlerFactory
                order="first"
                implementation="io.github.ayfri.kore.koreassistant.references.KoreFunctionFindUsagesHandlerFactory"/>
        <renameInputValidator implementation="io.github.ayfri.kore.koreassistant.references.KoreFunctionRenameInputValidator"/>
        <usageTypeProvider
                order="first"
                implementation="io.github.ayfri.kore.koreassistant.references.KoreFunctionUsageTypeProvider"/>

        <consoleFilterProvider implementation="io.github.ayfri.kore.koreassistant.console.KoreConsoleFilterProvider"/>

        <codeInsight.declarativeInlayProvider
                language="kotlin"
                implementationClass="io.github.ayfri.kore.koreassistant.hints.KoreLocationInlayHintsProvider"
                isEnabledByDefault="true"
                group="OTHER_GROUP"
                providerId="kore.locations"
                bundle="messages.KoreBundle"
                nameKey="inlay.kore.locations.name"
                descriptionKey="inlay.kore.locations.description">
            <option bundle="messages.KoreBundle"
                    optionId="location"
                    enabledByDefault="true"
                    nameKey="inlay.kore.locations.option.location"
                    descriptionKey="inlay.kore.locations.option.location.description"/>
            <option bundle="messages.KoreBundle"
                    optionId="path"
                    enabledByDefault="false"
                    nameKey="inlay.kore.locations.option.path"
                    descriptionKey="inlay.kore.locations.option.path.description"/>
        </codeInsight.declarativeInlayProvider>

        <!-- First, so it can stop the file-name variants the platform adds to every string. -->
        <completion.contributor
                language="kotlin"
                order="first"
                implementationClass="io.github.ayfri.kore.koreassistant.completion.KoreStringCompletionContributor"/>
        <!-- First, so Kotlin's own confidence does not veto the popup inside the strings this plugin completes. -->
        <completion.confidence
                language="kotlin"
                order="first"
                implementationClass="io.github.ayfri.kore.koreassistant.completion.KoreStringCompletionConfidence"/>

        <localInspection
                language="kotlin"
                shortName="KoreDuplicateDeclaration"
                displayName="Duplicate Kore declaration"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.DuplicateDeclarationInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreUnresolvedFunctionReference"
                displayName="Unresolved Kore function reference"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.UnresolvedFunctionReferenceInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreCraftingShaped"
                displayName="Invalid shaped recipe pattern"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.CraftingShapedInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreUnknownVanillaId"
                displayName="Unknown vanilla id"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.UnknownVanillaIdInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreGeneratedEnumMutation"
                displayName="Mutation of a shared generated enum entry"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.GeneratedEnumMutationInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreMixedCoordinates"
                displayName="Local coordinates mixed with relative or absolute ones"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.MixedCoordinatesInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreMacroName"
                displayName="Invalid macro name"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.MacroNameInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreMacroArguments"
                displayName="Missing or unused macro arguments"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.MacroArgumentsInspection"/>
        <localInspection
                language="kotlin"
                shortName="KoreUnusedMacro"
                displayName="Unused macro"
                groupPath="Kotlin"
                groupName="Kore"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.ayfri.kore.koreassistant.inspections.UnusedMacroInspection"/>
    </extensions>

    <actions>
        <action id="Kore.NewDataPack" class="io.github.ayfri.kore.koreassistant.templates.NewKoreDataPackAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="io.github.ayfri.kore.koreassistant.toolwindow.KoreRootsListener"
                  topic="com.intellij.openapi.roots.ModuleRootListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>
</idea-plugin>
